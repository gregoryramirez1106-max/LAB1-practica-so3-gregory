# 1. Crear carpeta, archivo y editar con vi
mkdir materia
cd materia
vi estudiante.txt
# (Dentro de vi: presionar 'i', escribir nombre y matrícula, presionar Esc, escribir :wq y Enter)

# 2. Permisos para que solo el usuario propietario tenga control total (rwx------)
chmod 700 estudiante.txt

# 3. Permisos para que solo el grupo propietario tenga control total (---rwx---)
chmod 070 estudiante.txt

# 4. Crear carpeta materia2 y copiar el archivo dentro de ella
chmod 644 estudiante.txt
cd ..
mkdir materia2
cp materia/estudiante.txt materia2/

# 5. Eliminar la carpeta materia junto con su archivo
rm -rf materia
